<html>
  <head>
    <title>Form</title>
  </head>
  <body>
    <h2>New Message</h2>
    <a href="/">View all messages</a>
    <form method="POST" action="/new"> 
        <input type="text" name="user" placeholder="Your Name" required />
        <input type="text" name="text" placeholder="Your message" required />
        <button type="submit">Send</button>
    </form>
  </body>
</html>